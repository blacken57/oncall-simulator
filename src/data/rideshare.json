      "name": "Edge Gateway",
      "type": "compute",
      "physics": {
        "request_capacity_per_unit": 100,
        "latency_base_ms": 8,
        "latency_load_factor": 0.005,
        "saturation_threshold_percent": 85,
        "saturation_penalty_factor": 0.15,
        "resource_base_usage": {
          "cpu": 2.0
        },
        "consumption_rates": {
          "cpu": 0.0005
        },
        "noise_factor": 0.1
      },
      "attributes": {
        "cpu": {
          "name": "CPU Cores",
          "unit": "cores",
          "initialLimit": 40,
          "minLimit": 8,
          "maxLimit": 256,
          "apply_delay": 3
        }
      },
      "metrics": {
        "incoming": {
          "name": "Requests",
          "unit": "req/s"
        },
        "latency": {
          "name": "P99 Latency",
          "unit": "ms"
        },
        "error_rate": {
          "name": "Error Rate",
          "unit": "%"
